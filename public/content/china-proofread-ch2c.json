    {
      "id": "china-reviewed-ch2c-overview-0",
      "knowledgeId": "china-reviewed-ch2c-overview",
      "title": "人物与文献",
      "text": "墨子名翟，春秋末期战国初期人；原书采用“宋国人”的说法。《墨子》基本上由墨子的弟子和后人所作，是研究墨子和墨家的资料。",
      "keywords": [
        "翟",
        "墨子",
        "弟子与后人"
      ],
      "order": 0,
      "version": 1,
      "studyMode": "read"
    },
    {
      "id": "china-reviewed-ch2c-overview-1",
      "knowledgeId": "china-reviewed-ch2c-overview",
      "title": "思想框架",
      "text": "教育实践：“农与工肆之人”的代表；教育作用：“素丝说”；培养目标：“兼士”或“贤士”；教育内容以科学技术教育和思维训练教育为主要特色；教育方法：主动、创造、实践、量力；历史影响与评价。",
      "keywords": [
        "农与工肆之人",
        "素丝说",
        "兼士",
        "主动创造实践量力"
      ],
      "order": 1,
      "version": 1,
      "studyMode": "read"
    },
    {
      "id": "china-reviewed-ch2c-practice-0",
      "knowledgeId": "china-reviewed-ch2c-practice",
      "title": "代表的阶层与利益",
      "text": "墨子是“农与工肆之人”的代表。“农”指农民，“工肆”指小手工业者；墨子代表着下层人民的利益。",
      "keywords": [
        "农民",
        "小手工业者",
        "下层人民"
      ],
      "order": 0,
      "version": 1,
      "studyMode": "memorize"
    },
    {
      "id": "china-reviewed-ch2c-practice-1",
      "knowledgeId": "china-reviewed-ch2c-practice",
      "title": "上说下教与墨家学派",
      "text": "墨子“上说下教”，形成了一个有政纲、有领导、有组织、有纪律的墨家学派。",
      "keywords": [
        "上说下教",
        "政纲领导组织纪律"
      ],
      "order": 1,
      "version": 1,
      "studyMode": "memorize"
    },
    {
      "id": "china-reviewed-ch2c-practice-2",
      "knowledgeId": "china-reviewed-ch2c-practice",
      "title": "组织特点的评价",
      "text": "墨家学派具有侠义作风、牺牲精神和献身精神；原书同时指出，其组织严密，俨然像一个宗教政治团体。",
      "keywords": [
        "侠义",
        "牺牲献身",
        "组织严密"
      ],
      "order": 2,
      "version": 1,
      "studyMode": "memorize"
    },
    {
      "id": "china-reviewed-ch2c-role-0",
      "knowledgeId": "china-reviewed-ch2c-role",
      "title": "对个人：教育与环境改变人性",
      "text": "人性如待染的“素丝”，教育与环境可以改变人性。“染于苍则苍，染于黄则黄，所入者变，其色亦变。”",
      "keywords": [
        "待染素丝",
        "教育环境",
        "改变人性"
      ],
      "order": 0,
      "version": 1,
      "studyMode": "memorize"
    },
    {
      "id": "china-reviewed-ch2c-role-1",
      "knowledgeId": "china-reviewed-ch2c-role",
      "title": "对社会：建立兼爱社会",
      "text": "通过教育建立民众平等、互助的“兼爱”社会。",
      "keywords": [
        "平等",
        "互助",
        "兼爱社会"
      ],
      "order": 1,
      "version": 1,
      "studyMode": "memorize"
    },
    {
      "id": "china-reviewed-ch2c-role-2",
      "knowledgeId": "china-reviewed-ch2c-role",
      "title": "评价：天赋平等的色彩",
      "text": "原书认为，与孔子相比，“素丝说”更明确且富有天赋平等的色彩，其社会意义更趋于进步。",
      "keywords": [
        "天赋平等",
        "社会意义"
      ],
      "order": 2,
      "version": 1,
      "studyMode": "memorize"
    },
    {
      "id": "china-reviewed-ch2c-role-3",
      "knowledgeId": "china-reviewed-ch2c-role",
      "title": "辅助比较：洛克白板说",
      "text": "原书将“素丝说”与 18 世纪洛克的“白板说”作类比，并称前者早近 2300 年。校勘：洛克《人类理解论》初版于 1689/1690 年，属 17 世纪；这里不把“18 世纪”作为事实背诵。两说可作类比，不据此认定为同一理论。出处见《墨子与墨家校对记录》。",
      "keywords": [
        "素丝说",
        "白板说",
        "17世纪"
      ],
      "order": 3,
      "version": 1,
      "studyMode": "read"
    },
